{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "skipLibCheck": false,
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false,

    "lib": ["es2024", "dom"]
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*"]
}
