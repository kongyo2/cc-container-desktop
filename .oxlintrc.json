{
  "plugins": ["typescript", "import", "promise", "node", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off",
    "pedantic": "off"
  },
  "rules": {
    "no-console": "off",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off",
    "no-underscore-dangle": "off"
  },
  "ignorePatterns": ["node_modules", "out", "dist", "release", "coverage", "*.min.js"]
}
