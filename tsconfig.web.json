{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "isolatedDeclarations": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/web.tsbuildinfo",

    "target": "es2024",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom"],
    "jsx": "react-jsx",
    "types": [],
    "rootDir": "./",
    "allowImportingTsExtensions": true
  },
  "include": ["src/renderer/**/*", "src/shared/**/*"],
  "exclude": ["out", "dist", "release", "node_modules"]
}
