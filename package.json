{
  "name": "cc-container-desktop",
  "version": "0.7.0",
  "private": true,
  "description": "Claude Code container workbench — pre-built runtime images from Docker Hub, one Docker container per task, with per-task environments (image + variables + setup script), endpoints, models and API keys.",
  "author": "kongyo2",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -b --pretty false",
    "typecheck:watch": "tsc -b --watch --pretty false",
    "typecheck:ci": "tsc -b --force --pretty false --builders 4",
    "check:libs": "tsc -p tsconfig.node.libcheck.json --pretty false --checkers 4 && tsc -p tsconfig.web.libcheck.json --pretty false --checkers 4",
    "clean:ts": "tsc -b --clean",
    "lint": "oxlint --format agent",
    "lint:fix": "oxlint --fix",
    "lint:strict": "oxlint --deny-warnings",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run knip && npm run typecheck:ci && npm run check:libs && npm run test && npm run catalog:verify && npm run build",
    "pack:dir": "electron-vite build && electron-builder --dir",
    "dist:win": "electron-vite build && electron-builder --win --x64",
    "e2e": "node tests/e2e/workbench.mjs",
    "e2e:deep": "node tests/e2e/deep.mjs",
    "e2e:live": "node tests/e2e/live.mjs",
    "e2e:packaged": "node tests/e2e/packaged.mjs release/linux-unpacked/cc-container-desktop",
    "e2e:all": "npm run e2e:images && npm run e2e && npm run e2e:deep && npm run e2e:live",
    "test": "node --experimental-strip-types --test \"tests/unit/**/*.test.ts\"",
    "catalog:generate": "node --experimental-strip-types scripts/generate-image-catalog.mjs",
    "catalog:verify": "node --experimental-strip-types scripts/verify-image-catalog.mjs",
    "catalog:verify:online": "node --experimental-strip-types scripts/verify-image-catalog.mjs --online --require-published",
    "lock:update": "node scripts/update-image-lock.mjs",
    "lock:check": "node scripts/update-image-lock.mjs --check",
    "images:build": "docker buildx bake -f docker/docker-bake.hcl",
    "e2e:images": "node tests/e2e/images.mjs"
  },
  "dependencies": {
    "dockerode": "^5.0.1",
    "tar-fs": "^3.1.3",
    "tar-stream": "^3.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/tar-fs": "^2.0.4",
    "@types/tar-stream": "^3.1.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "knip": "^6.35.1",
    "lucide-react": "^1.34.0",
    "oxlint": "^1.80.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  },
  "desktopName": "cc-container-desktop.desktop"
}
